{
    "contract_version": "1.0.0",
    "description": "Cleaned and deduplicated checkout payment records. Source: bronze/checkout_payments Delta table.",
    "owner": "data-eng",
    "tags": [
        "payments",
        "checkout",
        "silver"
    ],
    "source_service_type": "DELTA",
    "database_schema": "silver",
    "table_name": "bronze/checkout_payments",
    "target_service_type": "DELTA",
    "target_layer": "silver",
    "target_tablename": "silver/checkout_payments_clean",
    "refresh_mode": "full_reload",
    "primary_keys": [
        {
            "name": "id",
            "type": "TEXT"
        }
    ],
    "watermark": null,
    "quality_rules": [
        {
            "rule_type": "not_null",
            "columns": [
                "id",
                "merchant_id",
                "amount",
                "captured_amount",
                "created_at"
            ]
        },
        {
            "rule_type": "unique",
            "columns": [
                "id"
            ]
        },
        {
            "rule_type": "value_range",
            "column": "amount",
            "min": 0
        },
        {
            "rule_type": "value_range",
            "column": "captured_amount",
            "min": 0
        },
        {
            "rule_type": "value_range",
            "column": "refund_amount",
            "min": 0
        }
    ]
}